---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Download the Vastrel End world",
	title: "End",
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-12 text-center">Vastrel End Downloads</h1>
		<p class="text-center"> THIS IS A TEMPLATE.</p>
		<br>
		<p class="text-center"> If You're seeing this, The project is still in progress and no downlaods are available yet.</p>
		<br>
		<p class="text-center"> Check back soon for updates!</p>
	</section>
</PageLayout>


