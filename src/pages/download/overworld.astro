---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Download the Vastrel Overworld world",
	title: "Overworld",
};

const previewImage = "/social-card.png"; // Temporary preview until world images are available.
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-12 text-center">Vastrel Overworld Downloads</h1>
		<p class="text-center"> THIS IS A TEMPLATE.</p>
		<br>
		<p class="text-center"> If You're seeing this, The project is still in progress and no downlaods are available yet.</p>
		<br>
		<p class="text-center"> Check back soon for updates!</p>

		<br>
		<br>
		<ul class="space-y-8">
			<li>
				<a aria-disabled="true" class="underline">Download the 312² Overworld</a> <span class="text-red-600 dark:text-green-400">(0Byte)</span>
				<a href={previewImage} target="_blank" rel="noopener noreferrer" aria-label="View full-size 312² Overworld preview" class="mt-3 block w-fit">
					<img src={previewImage} alt="Placeholder preview for the 312² Overworld" class="aspect-square w-48 rounded-lg object-cover sm:w-56" />
				</a>
			</li>

			<li>
				<a aria-disabled="true" class="underline">Download the 512² Overworld</a> <span class="text-red-600 dark:text-green-400">(0Byte)</span>
				<a href={previewImage} target="_blank" rel="noopener noreferrer" aria-label="View full-size 512² Overworld preview" class="mt-3 block w-fit">
					<img src={previewImage} alt="Placeholder preview for the 512² Overworld" class="aspect-square w-48 rounded-lg object-cover sm:w-56" />
				</a>
			</li>

			<li>
				<a aria-disabled="true" class="underline">Download the 1024² Overworld</a> <span class="text-red-600 dark:text-green-400">(0Byte)</span>
				<a href={previewImage} target="_blank" rel="noopener noreferrer" aria-label="View full-size 1024² Overworld preview" class="mt-3 block w-fit">
					<img src={previewImage} alt="Placeholder preview for the 1024² Overworld" class="aspect-square w-48 rounded-lg object-cover sm:w-56" />
				</a>
			</li>
		</ul>
	</section>
</PageLayout>


